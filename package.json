{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tinycast-clipboard",
  "title": "Tinycast Clipboard",
  "description": "Tinycast clipboard history with Return to copy and Command-Return to paste",
  "author": "viko16",
  "license": "MIT",
  "commands": [
    {
      "name": "clipboard-history",
      "title": "Clipboard History",
      "description": "Browse Tinycast clipboard history",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "2.0.6"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist -o dist && cp package.json dist/package.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "platforms": [
    "macOS"
  ]
}
